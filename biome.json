{
	"$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**",
			"!!**/node_modules",
			"!!**/.next",
			"!!**/out",
			"!!**/build",
			"!!**/dist",
			"!!**/coverage",
			"!!**/test-results",
			"!!**/playwright-report",
			"!!**/blob-report",
			"!!**/.wrangler",
			"!!.agents",
			"!!.codex",
			"!!.uv-cache",
			"!!.vercel",
			"!!**/supabase/.branches",
			"!!**/supabase/.temp",
			"!!private",
			"!!oauth-output",
			"!!next-env.d.ts",
			"!!types/routes.d.ts",
			"!!types/cache-life.d.ts",
			"!!**/*.min.js",
			"!!**/*.map"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
