{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Local `wrangler dev` only. Production infrastructure (vars, the bucket,
	// secrets) is declared in alchemy.run.ts at the repository root.
	"name": "wianki-archive",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-23",
	"observability": {
		"enabled": true
	},
	"vars": {
		// Host the platform is served from, without a scheme. Sites live on its
		// single-label subdomains (rosia.<PLATFORM_HOST>) or custom domains; the
		// origin each request may come from is signed into its token by the app.
		"PLATFORM_HOST": "localhost:3000",
		// "r2" keeps originals in the bucket below under
		// sites/<siteId>/originals/. Switch to "drive" to stream them into a
		// user-owned Google Drive folder instead: delete the "r2_buckets"
		// block, run `npm run drive:bootstrap`, and put the four GOOGLE_*
		// values from oauth-output/drive-oauth.json in as secrets.
		"ARCHIVE_BACKEND": "r2"
	},
	"r2_buckets": [
		{
			"binding": "ARCHIVE_BUCKET",
			"bucket_name": "wianki-originals"
		}
	]
}
