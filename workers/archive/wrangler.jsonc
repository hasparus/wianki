{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "wedding-archive",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-23",
	"observability": {
		"enabled": true
	},
	"vars": {
		"ALLOWED_ORIGIN": "https://wedding.pawel.space"
	},
	"r2_buckets": [
		{
			"binding": "ARCHIVE_BUCKET",
			"bucket_name": "wedding-originals"
		}
	]
}
