# Shared with Vercel as ARCHIVE_TOKEN_SECRET. At least 32 random bytes.
ARCHIVE_TOKEN_SECRET=replace_with_256_bit_random_value

# Only for ARCHIVE_BACKEND=drive. Produced by `npm run drive:bootstrap`,
# which writes them to the git-ignored oauth-output/drive-oauth.json.
# GOOGLE_OAUTH_CLIENT_ID=replace_me.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=replace_me
# GOOGLE_OAUTH_REFRESH_TOKEN=replace_me
# GOOGLE_DRIVE_FOLDER_ID=replace_me
