{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Local `wrangler dev` only. Production infrastructure (the Durable
	// Object, secrets) is declared in alchemy.run.ts at the repository root.
	// There are no vars: the origin a connection may come from and the room
	// it may join are signed into each token by the app. Only
	// LIVE_TOKEN_SECRET is needed, as a secret (.dev.vars locally).
	"name": "wianki-slideshow-live",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-23",
	"observability": {
		"enabled": true
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "SlideshowParty",
				"class_name": "SlideshowParty"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["SlideshowParty"]
		}
	]
}
