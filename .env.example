# Wianki platform configuration.
#
# Two consumers read this file:
#   - alchemy.run.ts (via `npx alchemy dev|deploy`, which loads `.env`) turns
#     the values below into Worker vars and encrypted secrets;
#   - `next dev` and the tests read `.env.local` through Next.js.
# Copy it to `.env` (alchemy) or `.env.local` (plain Next dev) and replace every
# placeholder. Neither copy is committed. Nothing here is a real value.

# --- Cloudflare account, used by alchemy only --------------------------------

# Account id from the Cloudflare dashboard sidebar.
CLOUDFLARE_ACCOUNT_ID=replace_with_account_id
# API token with the scopes listed in docs/deploy.md (Workers, D1, R2, zone).
CLOUDFLARE_API_TOKEN=replace_with_api_token
# Zone that holds PLATFORM_HOST. Optional: without it the app answers on its
# workers.dev URL only (previews, local dev).
# CLOUDFLARE_ZONE_ID=replace_with_zone_id

# --- Alchemy -----------------------------------------------------------------

# Encrypts secrets inside Alchemy state. Losing it means re-creating state.
ALCHEMY_PASSWORD=replace_with_a_long_random_password
# Stage name: dev (default), prod, pr-12, ... `--stage` on the CLI overrides it.
ALCHEMY_STAGE=dev
# Only for CI deploys, which keep state in the Cloudflare account instead of
# the local .alchemy/ directory: any long random string.
# ALCHEMY_STATE_TOKEN=replace_with_a_long_random_token

# --- Platform ----------------------------------------------------------------

# Host (no scheme) of the owner console. Sites are subdomains of it or custom
# domains stored in D1. Local: localhost:3000; the tests use platform.localhost.
PLATFORM_HOST=localhost:3000
# Root of every cookie and token key, at least 32 random bytes. Rotating it
# logs every owner, guest and admin out at once.
SESSION_SECRET=replace_with_256_bit_random_value
# Sender for owner magic links through Cloudflare Email Sending. The domain
# must be verified in the account. Unset = links are logged (dev only).
# EMAIL_FROM=wianki@example.com
# Set to false to close self-service sign-up while keeping existing sites.
SIGNUP_ENABLED=true
# Version string stamped on every upload batch when the consent copy changes.
CONSENT_VERSION=2026-07-23

# --- Archive Worker (workers/archive) ----------------------------------------

# Filled in by alchemy from the Worker's URL; needed by hand only for a plain
# `next dev` without alchemy (any URL will do when uploads are mocked).
ARCHIVE_WORKER_URL=https://wianki-archive-dev.example.workers.dev
NEXT_PUBLIC_ARCHIVE_WORKER_URL=https://wianki-archive-dev.example.workers.dev
# Shared by the app and the Worker: signs upload capabilities and receipts.
ARCHIVE_TOKEN_SECRET=replace_with_256_bit_random_value

# --- Live slideshow Worker (workers/slideshow-live) --------------------------

# URL is filled in by alchemy. The secret is handed to the Worker as
# LIVE_TOKEN_SECRET. Both unset in plain `next dev` = slideshow without
# live reactions.
SLIDESHOW_LIVE_URL=https://wianki-slideshow-live-dev.example.workers.dev
SLIDESHOW_LIVE_SECRET=replace_with_256_bit_random_value

# --- Google Vision SafeSearch (optional) -------------------------------------

# Used only by sites that turn moderation on. Set both or neither. Preserve
# the escaped \n in the private key.
# GOOGLE_VISION_CLIENT_EMAIL=vision-service-account@example.iam.gserviceaccount.com
# GOOGLE_VISION_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----\n"

# --- Stripe (optional) -------------------------------------------------------

# With a key, alchemy.run.ts creates the product, the yearly price, the
# storage meter, the overage price and the webhook, and passes the three
# values below into the app itself. Set them by hand only for a plain
# `next dev` against resources that already exist.
# STRIPE_SECRET_KEY=sk_test_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# STRIPE_PRICE_YEARLY=price_replace_me
# STRIPE_PRICE_OVERAGE=price_replace_me
