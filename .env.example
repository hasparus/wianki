# Public Supabase connection details (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only Supabase credential. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Public application origin, without a trailing slash.
APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Generate each token independently with at least 32 random bytes.
GUEST_ENTRY_TOKEN=replace_with_256_bit_random_value

# Optional short join code for the slideshow's corner QR: /p/<code> grants a
# guest session. Keep it short enough to type, rotate independently of
# GUEST_ENTRY_TOKEN. Unset = no QR on /pokaz and /p/* stays closed.
GUEST_JOIN_CODE=wesele-zamien-mnie
GUEST_ACCESS_PASSPHRASE=replace_with_a_long_invitation_passphrase
GUEST_SESSION_SECRET=replace_with_256_bit_random_value
ADMIN_ENTRY_TOKEN=replace_with_256_bit_random_value
ADMIN_SESSION_SECRET=replace_with_256_bit_random_value

# Shared only by Vercel and the Cloudflare archive Worker.
ARCHIVE_WORKER_URL=https://wedding-drive-archive.example.workers.dev
NEXT_PUBLIC_ARCHIVE_WORKER_URL=https://wedding-drive-archive.example.workers.dev
ARCHIVE_TOKEN_SECRET=replace_with_256_bit_random_value

# Live slideshow reactions worker (workers/slideshow-live). Optional — leave
# both unset to run the slideshow without live reactions and comments.
# SLIDESHOW_LIVE_SECRET is shared with the worker as LIVE_TOKEN_SECRET.
SLIDESHOW_LIVE_URL=https://wedding-slideshow-live.example.workers.dev
SLIDESHOW_LIVE_SECRET=replace_with_256_bit_random_value

# Set to false to skip Google Vision SafeSearch and auto-approve every photo at
# finalization (they appear in the gallery immediately). Defaults to true.
MODERATION_ENABLED=true

# Google Vision service-account values. Preserve escaped \n in the private key.
# Required only when MODERATION_ENABLED is not false.
GOOGLE_CLOUD_PROJECT_ID=replace_me
GOOGLE_VISION_CLIENT_EMAIL=vision-service-account@example.iam.gserviceaccount.com
GOOGLE_VISION_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----\n"

# Shown in the Polish privacy notice.
DELETION_CONTACT_EMAIL=photos@example.com

# Optional deployment/runtime settings.
CONSENT_VERSION=2026-07-23
