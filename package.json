{
	"name": "wedding-photos-app",
	"version": "0.1.0",
	"private": true,
	"engines": {
		"node": "24.x"
	},
	"workspaces": [
		"workers/*"
	],
	"overrides": {
		"postcss": "^8.5.12",
		"sharp": "^0.35.0"
	},
	"scripts": {
		"prepare": "husky",
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome check .",
		"format": "biome check --write .",
		"typegen": "next typegen",
		"typecheck": "npm run typegen && tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:worker": "npm --workspace @wedding/drive-archive run check",
		"test:e2e": "playwright test",
		"check": "npm run lint && npm run typecheck && npm run test && npm run test:worker && npm run build",
		"qr:generate": "node scripts/generate-qr.mjs",
		"drive:bootstrap": "node scripts/bootstrap-drive-oauth.mjs",
		"pre-commit": "lint-staged"
	},
	"dependencies": {
		"@biomejs/biome": "^2.5.5",
		"@supabase/supabase-js": "^2.57.4",
		"browser-image-compression": "^2.0.2",
		"husky": "^9.1.7",
		"jose": "^6.1.0",
		"next": "16.2.11",
		"qrcode": "^1.5.4",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"zod": "^4.1.11"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.10.2",
		"@playwright/test": "^1.55.1",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/qrcode": "^1.5.5",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "16.2.11",
		"git-format-staged": "^4.0.1",
		"lint-staged": "^17.2.0",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vitest": "^3.2.4"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc,css}": [
			"biome check --write --no-errors-on-unmatched"
		]
	}
}
