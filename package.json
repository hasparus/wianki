{
	"name": "wedding-photos-app",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"workspaces": [
		"workers/*"
	],
	"overrides": {
		"postcss": "^8.5.12",
		"sharp": "^0.35.0"
	},
	"scripts": {
		"prepare": "husky",
		"dev": "next dev",
		"build": "next build",
		"build:cf": "opennextjs-cloudflare build --config wrangler.local.jsonc",
		"preview": "npm run build:cf && opennextjs-cloudflare preview --config wrangler.local.jsonc",
		"start": "next start",
		"infra:dev": "alchemy dev",
		"infra:deploy": "alchemy deploy",
		"infra:destroy": "alchemy destroy",
		"db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
		"db:seed:local": "wrangler d1 execute DB --local --config wrangler.local.jsonc --file=db/seed-dev.sql",
		"db:reset:local": "npm run db:migrate:local && npm run db:seed:local",
		"lint": "biome check .",
		"format": "biome check --write .",
		"typegen": "next typegen",
		"typecheck": "npm run typegen && tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:worker": "npm run check --workspaces",
		"test:e2e": "playwright test",
		"check": "npm run lint && npm run typecheck && npm run test && npm run test:worker && npm run build",
		"qr:generate": "node scripts/generate-qr.ts",
		"drive:bootstrap": "node scripts/bootstrap-drive-oauth.ts",
		"pre-commit": "lint-staged",
		"photos:upload": "node scripts/upload-photos.ts",
		"deck": "node scripts/deck.ts"
	},
	"dependencies": {
		"@biomejs/biome": "^2.5.5",
		"@opennextjs/cloudflare": "^1.20.14",
		"browser-image-compression": "^2.0.2",
		"husky": "^9.1.7",
		"jose": "^6.1.0",
		"motion": "13.3.0",
		"next": "^16.4.3",
		"partysocket": "^1.3.0",
		"qrcode": "^1.5.4",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"stripe": "^18.5.0",
		"zod": "^4.1.11"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.10.2",
		"@cloudflare/workers-types": "^5.20261029.1",
		"@playwright/test": "^1.55.1",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^24.19.2",
		"@types/qrcode": "^1.5.5",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"alchemy": "^0.94.0",
		"eslint": "^9",
		"eslint-config-next": "^16.4.3",
		"git-format-staged": "^4.0.1",
		"impeccable": "^4.1.0",
		"lint-staged": "^17.2.0",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vitest": "^3.2.4",
		"wrangler": "^4.155.0"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc,css}": [
			"biome check --write --no-errors-on-unmatched"
		]
	}
}
